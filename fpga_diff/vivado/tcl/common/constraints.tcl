# Debug clock: clk5_p is 25MHz by default; TIMING_DEBUG_CLK_PERIOD_NS=20.000
# selects the 50MHz variant (both are declared in the debug_clock_*.xdc files).
set debug_clk_period 40.000
if {[info exists ::env(TIMING_DEBUG_CLK_PERIOD_NS)] &&
    [string trim $::env(TIMING_DEBUG_CLK_PERIOD_NS)] ne ""} {
  set debug_clk_period [string trim $::env(TIMING_DEBUG_CLK_PERIOD_NS)]
}
if {![string is double -strict $debug_clk_period] || $debug_clk_period <= 0} {
  error "TIMING_DEBUG_CLK_PERIOD_NS must be a positive number, got '$debug_clk_period'"
}
set debug_clk_period_value [expr {double($debug_clk_period)}]
if {$debug_clk_period_value == 20.0} {
  set debug_clk_xdc debug_clock_50.xdc
} elseif {$debug_clk_period_value == 40.0} {
  set debug_clk_xdc debug_clock_25.xdc
} else {
  error "TIMING_DEBUG_CLK_PERIOD_NS must be 20.000 or 40.000, got '$debug_clk_period'"
}
puts "INFO: DEBUG_CLK_IN period=${debug_clk_period} ns; selected $debug_clk_xdc"

# Optional CPU/SoC core clock derived from clk6_p (200MHz) by the divider in
# fpga_top_debug.sv.  FPGA_CORE_CLK_MHZ selects the frequency (any positive
# integer that divides 200 evenly: 100, 50, 40, 25, 20, ...); the generated
# clock is written next to the project so the divide ratio always matches the
# RTL defines emitted by defines.tcl.
set core_clk_mhz 0
if {[info exists ::env(FPGA_CORE_CLK_MHZ)] &&
    [string trim $::env(FPGA_CORE_CLK_MHZ)] ne ""} {
  set core_clk_mhz [string trim $::env(FPGA_CORE_CLK_MHZ)]
} elseif {[info exists ::env(FPGA_CORE_CLK_100M)] &&
          [string trim $::env(FPGA_CORE_CLK_100M)] eq "1"} {
  set core_clk_mhz 100
}
set core_clk_xdc ""
if {$core_clk_mhz ne 0 && $core_clk_mhz ne "0"} {
  if {![string is integer -strict $core_clk_mhz] || $core_clk_mhz <= 0} {
    error "FPGA_CORE_CLK_MHZ must be a positive integer, got '$core_clk_mhz'"
  }
  if {200 % $core_clk_mhz != 0} {
    error "FPGA_CORE_CLK_MHZ must divide the 200MHz board clock evenly, got '$core_clk_mhz'"
  }
  if {$core_clk_mhz < 25 || $core_clk_mhz > 100} {
    error "FPGA_CORE_CLK_MHZ must be between 25 and 100 (clk6_p/2 .. clk6_p/8, BUFGCE_DIV range), got '$core_clk_mhz'"
  }
  set core_clk_div [expr {200 / $core_clk_mhz}]
  set core_clk_xdc [file join $project_dir core_clock.xdc]
  set fd [open $core_clk_xdc w]
  puts $fd "# Generated by constraints.tcl: CPU/SoC core clock = clk6_p/$core_clk_div = ${core_clk_mhz}MHz"
  puts $fd "# Divider implemented in fpga_diff/src/rtl/common/fpga_top_debug.sv."
  puts $fd "create_generated_clock -name CORE_CLK \\"
  puts $fd "  -source \[get_ports clk6_p\] \\"
  puts $fd "  -divide_by $core_clk_div \\"
  puts $fd "  \[get_pins bufg_core_clk/O\]"
  close $fd
  puts "INFO: FPGA_CORE_CLK_MHZ=$core_clk_mhz; core clock = clk6_p/$core_clk_div, constraints: $core_clk_xdc"
}

# Fixed 50MHz UART clock: the AXI bridge that hosts the 16550 is clocked from
# clk6_p/4 (bufg_uart_clk in fpga_top_debug.sv) so the UART bit rate does not
# depend on the selectable core clock.
set uart_clk_xdc [file join $project_dir uart_clock.xdc]
set fd [open $uart_clk_xdc w]
puts $fd "# Generated by constraints.tcl: UART/AXI-bridge clock = clk6_p/4 = 50MHz"
puts $fd "# Divider implemented in fpga_diff/src/rtl/common/fpga_top_debug.sv."
puts $fd "create_generated_clock -name UART_CLK \\"
puts $fd "  -source \[get_ports clk6_p\] \\"
puts $fd "  -divide_by 4 \\"
puts $fd "  \[get_pins bufg_uart_clk/O\]"
close $fd
puts "INFO: UART/AXI-bridge clock = clk6_p/4 (50MHz)"

set constr_files [list \
  [file normalize ${constr_dir}/$debug_clk_xdc] \
  [file normalize ${constr_dir}/cpu_clock.xdc] \
]
if {$core_clk_xdc ne ""} {
  lappend constr_files $core_clk_xdc
}
lappend constr_files $uart_clk_xdc
lappend constr_files \
  [file normalize ${constr_dir}/ddr.xdc] \
  [file normalize ${constr_dir}/fpga.xdc] \
  [file normalize ${constr_dir}/debug.xdc]

if {!$::no_diff} {
  lappend constr_files [file normalize ${constr_dir}/xdma.xdc]
  puts "INFO: adding common XDMA/PCIe constraints: xdma.xdc"

  set xdma_link_width X4
  if {[info exists ::env(XDMA_LINK_WIDTH)] && [string trim $::env(XDMA_LINK_WIDTH)] ne ""} {
    set xdma_link_width [string trim $::env(XDMA_LINK_WIDTH)]
  }
  if {[lsearch -exact {X4 X8} $xdma_link_width] < 0} {
    error "XDMA_LINK_WIDTH must be one of X4/X8, got '$xdma_link_width'"
  }
  if {$xdma_link_width eq "X4"} {
    set xdma_lane_xdc xdma_x4_lanes.xdc
  } else {
    set xdma_lane_xdc xdma_x8_lanes.xdc
  }
  lappend constr_files [file normalize ${constr_dir}/$xdma_lane_xdc]
  puts "INFO: XDMA_LINK_WIDTH=$xdma_link_width; selected $xdma_lane_xdc"

  set enable_ila 0
  if {[info exists ::env(ENABLE_ILA)]} {
    set enable_ila_value [string tolower [string trim $::env(ENABLE_ILA)]]
    if {[lsearch -exact {1 true yes on} $enable_ila_value] >= 0} {
      set enable_ila 1
    }
  }
  if {$enable_ila} {
    puts "INFO: ENABLE_ILA=$::env(ENABLE_ILA); adding host-trigger ILA XDC"
    lappend constr_files [file normalize ${constr_dir}/xdma_ila.xdc]
  } else {
    puts "INFO: ENABLE_ILA disabled; skipping host-trigger ILA XDC"
  }
} else {
  puts "INFO: NO_DIFF=1; skipping common XDMA/PCIe, lane, and host-trigger ILA XDC"
}
